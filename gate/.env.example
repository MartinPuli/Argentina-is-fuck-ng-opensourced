# AkashML (open model that reads context). Key: akashml.com -> Settings -> API Keys
AKASHML_API_KEY=
AKASHML_MODEL=openai/gpt-oss-120b

# Guild (agent that writes reviewer briefs). Needs the `guild` CLI logged in on the host.
GUILD_WORKSPACE=nicopujia~publication-gate
GUILD_AGENT=nicopujia~pami-gate-reviewer

# ClickHouse Cloud (audit log). Leave empty to log to local SQLite.
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Password for the internal pages. Empty means open (local dev only).
GATE_STAFF_PASSWORD=
