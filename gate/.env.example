# Required staff authentication. Set a private password before starting.
# Missing/empty password disables internal routes; there is no open-access fallback.
GATE_STAFF_USERNAME=reviewer
GATE_STAFF_PASSWORD=

# Optional SQLite path. Choose a new unused filename for a fresh demo.
# GATE_DB=./gate-demo.db

# Optional AkashML context/vision checks. Leave the key empty for offline review.
# Configured models receive document content; open models do not guarantee privacy.
AKASHML_API_KEY=
AKASHML_MODEL=openai/gpt-oss-120b
AKASHML_VISION_MODEL=Qwen/Qwen3.8-27B
# AKASHML_BASE_URL=https://api.akashml.com/v1

# Optional Guild briefs. Supply your own owner~workspace and owner~agent values.
# Requires the `guild` CLI authenticated on the host. No publication authority.
GUILD_WORKSPACE=
GUILD_AGENT=

# Optional ClickHouse audit backend. Empty host uses local SQLite.
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_SECURE=1

# Pi Security is NOT connected. Its hosted connector needs a Pi tenant and OAuth sign-in.
# PI_ENABLED=1 only changes the reason shown at /api/pi/status; it never fakes a connection.
# PI_ENABLED=

# Optional existing Tesseract language-data directory, containing spa.traineddata.
# TESSDATA_PREFIX=/path/to/tessdata

# Set to 1 to open the staff pages without a login (public demo with fictional data only).
GATE_OPEN_DEMO=
